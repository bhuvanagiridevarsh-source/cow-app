# Copy this file to ".env" (same folder) and fill in the two values.
# ".env" is git-ignored, so your real values are never uploaded to GitHub.
#
# Where to find them: Supabase dashboard -> your project -> Project Settings -> API Keys.

# Project URL, looks like https://abcdefghijkl.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# The "Publishable key" (starts with sb_publishable_) or the legacy "anon" key.
# This key is safe to put in the app. NEVER put the secret / service_role key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
