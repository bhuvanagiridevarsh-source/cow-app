{
  "expo": {
    "name": "CoW Project",
    "slug": "cow-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/cow-logo-256.png",
    "scheme": "cowproject",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "org.childrenofwarproject.app",
      "supportsTablet": false
    },
    "android": {
      "package": "org.childrenofwarproject.app",
      "adaptiveIcon": {
        "backgroundColor": "#7ABAE6",
        "foregroundImage": "./assets/brand/cow-logo-256.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6DC",
          "image": "./assets/brand/cow-logo-256.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0B1F2E",
            "image": "./assets/brand/cow-logo-256.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
