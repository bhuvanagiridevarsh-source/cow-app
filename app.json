{
  "expo": {
    "name": "CoW Project",
    "slug": "cow-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "cowproject",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "org.childrenofwarproject.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.childrenofwarproject.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#FFF6DC"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "CoW uses a photo you choose to show the item you are donating.",
          "cameraPermission": "CoW uses the camera so you can take a photo of the item you are donating.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CoW uses your location to show donated items near you. It stays on your phone.",
          "locationAlwaysAndWhenInUsePermission": "CoW uses your location to show donated items near you. It stays on your phone.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6DC",
          "image": "./assets/brand/splash.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0B1F2E",
            "image": "./assets/brand/splash.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
